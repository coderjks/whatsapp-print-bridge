{
  "name": "whatsapp-print-bridge",
  "version": "0.1.0",
  "description": "WhatsApp to printer bridge: download files from WhatsApp and print via CUPS",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.18",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "pdf-lib": "^1.17.1",
    "pdf-to-printer": "^5.8.1",
    "pino": "^9.5.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.34.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.7.0",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "protobufjs@7.6.6": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
