# CUPS printer to use (see `lpstat -p -d`). Empty = system default.
PRINTER_NAME=
# Comma-separated WhatsApp numbers/JIDs allowed to print, e.g. 919999999999,15551234567
# Leave empty to allow anyone who messages the session (not recommended).
# Overridable from the dashboard Allowed senders panel (stored in the DB).
ALLOWED_NUMBERS=
# Default when user just replies PRINT
DEFAULT_COLOR_MODE=BW
DEFAULT_COPIES=1
# Max download size in MB
MAX_FILE_MB=20
# Where downloads land
INBOX_DIR=./inbox
# WhatsApp number to link (digits only, e.g. 919876543210).
# When set, the dashboard shows an 8-digit pairing code instead of a QR.
# When empty, linking uses the QR-code flow.
WHATSAPP_NUMBER=
# Require dashboard approval before printing (overridable from the UI toggle).
# ON: files wait for admin preview + Approve & Print. OFF: WhatsApp PRINT prints directly.
ADMIN_APPROVAL=false
# Skip real printing: log + archive PDFs to inbox/printed/ instead of calling `lp`.
# Ideal for end-to-end testing without a printer. Overridable from the UI Mock print switch.
MOCK_PRINT=true
# Web dashboard port
PORT=3000
# CUPS server (only needed in Docker if CUPS runs on host)
# CUPS_SERVER=host.docker.internal:631
